@* The sign-in screen (spec §4): an address, then the code — one page, one tab. *@
<Page Title="Sign in">
    <div id="sign-in">
        @if (AskForCode)
        {
            <CodeStep Email="@Email" Error="@Error" ReturnUrl="@ReturnUrl" />
        }
        else
        {
            <EmailStep Email="@Email" Error="@Error" ReturnUrl="@ReturnUrl" />
        }
    </div>
    <section id="about">
        <h2>Welcome to SplitIt 👋</h2>
        <p>
            SplitIt is a small, friendly app for sharing costs with the people you travel, live or hang out with.
            Add expenses as they happen, say who took part, and SplitIt keeps track of who owes whom, so settling up is easy and fair.
        </p>
        <p>
            It's a hobby project, built to be simple, quick on a phone and free of clutter. You're very welcome to try it with your friends.
        </p>
        <div class="warning">
            <p><strong>Heads up:</strong> SplitIt is still under development. Data may be changed or disappear without notice, so don't rely on it as your only record of money that matters.</p>
        </div>
    </section>
</Page>

@code {
    [Parameter] public string Email { get; set; } = "";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool AskForCode { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }
}
